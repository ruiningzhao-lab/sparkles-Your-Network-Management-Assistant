# Copy to .env.local and fill in. Everything is optional for a first local try.

# --- AI (optional) ---
# Without a key, Sparkles still works and matches requests by keywords.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5        # maps
# ANTHROPIC_MODEL_QUICK=claude-haiku-5-5   # drafts, next steps, city lookup

# --- Supabase (needed to invite other people) ---
# Leave empty to run in local mode: one user, data saved in .data/ on this computer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Emails that become admins on first sign-in (comma separated). Admins create invite links.
ADMIN_EMAILS=

# The public address of the app, used in sign-in emails and invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional
# NEXT_PUBLIC_APP_NAME=Sparkles
# LOCAL_USER_NAME=Your name   # greeting in local mode
